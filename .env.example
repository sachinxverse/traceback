# --- Core ---
FLASK_ENV=development
APP_CONFIG=development
SECRET_KEY=change-me-to-a-random-32-plus-byte-secret
JWT_SECRET_KEY=change-me-to-another-random-secret
DATABASE_URL=sqlite:///traceback.db
BASE_URL=http://localhost:5000

# --- Storage ---
UPLOAD_DIR=./instance/uploads
STORAGE_BACKEND=local
# S3 options (when STORAGE_BACKEND=s3)
# S3_BUCKET=
# S3_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- AI matching ---
EMBEDDING_BACKEND=stub
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
TEXT_MODEL=all-MiniLM-L6-v2
MATCH_WEIGHTS=image=0.40,text=0.25,location=0.20,time=0.15
MATCH_MIN_SCORE=0.45
NOTIFY_MIN_SCORE=0.55
MATCH_TOP_N=10
MATCH_MAX_DAYS=90
MATCH_MAX_DISTANCE_KM=50
IMG_LOW=0.55
IMG_HIGH=0.92
TXT_LOW=0.25
TXT_HIGH=0.85
LOC_DECAY_KM=1.0
TIME_DECAY_DAYS=7

# --- Uploads ---
MAX_IMAGE_MB=5
MAX_IMAGES_PER_REPORT=4

# --- Retention ---
REPORT_RETENTION_DAYS=180

# --- Jobs ---
JOBS_SYNC=false

# --- Email (optional) ---
MAIL_ENABLED=false
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@traceback.local

# --- Rate limiting ---
RATELIMIT_STORAGE_URI=memory://

# --- Security ---
COOKIE_SECURE=false
